<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.newrelic.logging.logback13.NewRelicEncoder"/>
    </appender>

    <appender name="NEWRELIC_ASYNC" class="com.newrelic.logging.logback13.NewRelicAsyncAppender">
        <appender-ref ref="STDOUT"/>
    </appender>

    <root level="info">
        <appender-ref ref="NEWRELIC_ASYNC"/>
    </root>
</configuration>
